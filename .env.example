# ---------------------------------------------------------------------------
# Copy this file to .env for local development.
#   cp .env.example .env
#
# Nothing here is committed with real values. Production secrets are set in the
# Netlify UI (Site configuration -> Environment variables) - see the
# "Deploying to Netlify" section at the bottom for the exact list.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database (matches docker-compose.yml -> host port 5433)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://freelancer:freelancer@localhost:5433/freelancer?schema=public"

# Used only by the Prisma CLI (schema push / migrate). Locally the same URL;
# in production it must be the *unpooled* Neon connection because pgbouncer
# cannot run DDL. Prisma requires this to be defined even for `generate`.
DIRECT_URL="postgresql://freelancer:freelancer@localhost:5433/freelancer?schema=public"

# ---------------------------------------------------------------------------
# Auth.js v5 (NextAuth)
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
#
# AUTH_URL is deliberately omitted. `trustHost: true` in src/lib/auth.config.ts
# makes Auth.js derive the origin from the incoming request, so localhost and
# the deployed Netlify domain share one code path. Never hardcode localhost.
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Google OAuth - https://console.cloud.google.com/apis/credentials
# On Netlify, add the deployed domain to the authorised redirect URIs:
#   https://<site>.netlify.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth - https://github.com/settings/developers
# Callback URL: https://<site>.netlify.app/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Email magic links (SMTP). Required for the "Email" sign-in provider.
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="Freelancer Marketplace <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Payments / Escrow
# PAYMENT_PROVIDER=mock keeps everything offline. Switch to "razorpay" once
# real Route (split-payout) credentials are available.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_ACCOUNT_NUMBER=""

# ---------------------------------------------------------------------------
# Marketplace economics
# Platform commission in basis points (1000 bps = 10.00%)
# ---------------------------------------------------------------------------
PLATFORM_COMMISSION_BPS="1000"


# ===========================================================================
# Deploying to Netlify
# ===========================================================================
#
# 1. Provision a Neon Postgres project. Neon exposes two connection strings;
#    the app needs the pooled one and the CLI needs the direct one.
#    Copy them from the Neon dashboard ("Connection string" -> Pooled / Direct).
#
#      DATABASE_URL = postgresql://<user>:<pass>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#      DIRECT_URL   = postgresql://<user>:<pass>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
#
#    Note the `-pooler` host on DATABASE_URL. Do not append `pgbouncer=true` or
#    `connection_limit=1` by hand: Neon's pooled endpoint already handles
#    transaction-mode pooling, and Prisma overrides the limit per request.
#
# 2. Create the schema once, from your machine, against the direct connection:
#
#      $env:DATABASE_URL="<pooled url>"; $env:DIRECT_URL="<direct url>"
#      npx prisma db push
#
#    There is no prisma/migrations directory yet. Once the schema is stable,
#    baseline it with `npx prisma migrate dev --name init` and switch the
#    deploy step to `npx prisma migrate deploy`.
#
# 3. Set these variables in the Netlify UI, then deploy:
#
#      DATABASE_URL            <pooled Neon URL>
#      DIRECT_URL              <direct Neon URL>
#      AUTH_SECRET             output of: npx auth secret
#      AUTH_TRUST_HOST         true
#      NODE_VERSION            22        (already set in netlify.toml)
#      PLATFORM_COMMISSION_BPS 1000      (optional, this is the default)
#      PAYMENT_PROVIDER        mock      (optional, until Razorpay keys exist)
#
#    Do not set AUTH_URL. Also do not copy DATABASE_URL/DIRECT_URL from a local
#    .env - those point at localhost:5433.
#
# 4. netlify.toml already runs `prisma generate` as part of the build, and
#    prisma/schema.prisma declares the `rhel-openssl-3.0.x` engine target that
#    Netlify Functions require.
